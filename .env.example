# Supabase: Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Kunci "service_role". Rahasia, hanya dipakai di server. Jangan diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Login Google (Google Cloud Console > APIs & Services > Credentials > OAuth client ID)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Buat dengan: npx auth secret   (atau: openssl rand -base64 32)
AUTH_SECRET=

# Hanya akun Google dengan email ini yang bisa masuk sebagai pemilik
OWNER_EMAIL=emailkamu@gmail.com

# Google Drive (galeri client): service account dari Google Cloud > IAM & Admin > Service Accounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=nama@project-id.iam.gserviceaccount.com
# Isi "private_key" dari file JSON kunci, dalam satu baris dengan \n apa adanya, diapit tanda kutip ganda
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Zona waktu studio, dipakai untuk menentukan "hari ini" di Client Portal
STUDIO_TIMEZONE=Asia/Makassar

# Isi hanya jika di-host di luar Vercel (misalnya VPS)
# AUTH_TRUST_HOST=true
